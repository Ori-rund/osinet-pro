# העתק ל-.env ומלא. הקובץ .env לא נכנס ל-git (ראה .gitignore).

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://peymjlrerncrtjclcpod.supabase.co

# service_role, לא anon/publishable.
# Supabase → Project Settings → API → service_role secret
# עוקף RLS. רק בשרת. לעולם לא בקוד צד לקוח ולא ב-git.
SUPABASE_SERVICE_KEY=

# ── טלגרם ─────────────────────────────────────────────────
# my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# הפלט של login_telegram.py. גישה מלאה לחשבון — שמור בהתאם.
TELEGRAM_SESSION=

# ── סינון וסיכום AI ───────────────────────────────────────
# אופציונלי אבל מומלץ מאוד. בלי אף מפתח המערכת עובדת על היוריסטיקה,
# שמסננת סביר אבל מפספסת מקרים גבוליים (מי תוקף את מי) ולא מסכמת.
# סדר עדיפות בפועל (ראה relevance._call_ai): Cerebras ← Groq ← Mistral
# ← Gemini ← Claude — כל ספק שנכשל מפיל לספק הבא, לא רק כשהמפתח שלו
# חסר. כדאי להגדיר כמה שיותר מהחינמיים — כל ספק נוסף מקטין את הסיכוי
# שכולם נופלים יחד באותו חלון זמן.
#
# Cerebras — חינמי, בלי כרטיס אשראי. המכסה היומית הנדיבה ביותר מבין
# הארבעה (ספטמבר 2026: ~1M טוקנים / 14,400 בקשות ביום). מפתח:
# cloud.cerebras.ai
CEREBRAS_API_KEY=
CEREBRAS_MODEL=llama3.1-8b

# Groq — חינמי. מודל קטן (8B) נותן מכסה יומית גדולה בהרבה ממודלים
# גדולים יותר על אותו ספק. מפתח: console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# Mistral — חינמי, בלי כרטיס אשראי (רק אימות טלפון). מפתח:
# console.mistral.ai
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Gemini — חינמי, אבל המכסה היומית בפועל התבררה הכי נמוכה מבין
# הספקים החינמיים — לכן אחרון בתור. מפתח: aistudio.google.com/apikey
# (לא דורש כרטיס אשראי)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Claude — גיבוי אחרון, בתשלום לפי שימוש. מפתח:
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
FILTER_MODEL=claude-haiku-4-5-20251001

# ── כוונון ────────────────────────────────────────────────
RSS_INTERVAL_SEC=300        # כל כמה זמן לסרוק פידים
DEDUP_WINDOW_HOURS=6        # חלון לאיחוד דיווחים על אותו אירוע
MAX_ITEMS_PER_FETCH=25      # תקרת פריטים לפיד בסבב
BACKFILL_LIMIT=10           # הודעות אחרונות לערוץ בעלייה
DRY_RUN=false               # true = מדפיס בלבד, לא כותב ל-DB
LOG_LEVEL=INFO
