# העתק ל-.env ומלא. הקובץ .env לא נכנס ל-git (ראה .gitignore).

# ── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://peymjlrerncrtjclcpod.supabase.co

# service_role, לא anon/publishable.
# Supabase → Project Settings → API → service_role secret
# עוקף RLS. רק בשרת. לעולם לא בקוד צד לקוח ולא ב-git.
SUPABASE_SERVICE_KEY=

# ── טלגרם ─────────────────────────────────────────────────
# my.telegram.org → API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# הפלט של login_telegram.py. גישה מלאה לחשבון — שמור בהתאם.
TELEGRAM_SESSION=

# ── סינון וסיכום AI ───────────────────────────────────────
# אופציונלי אבל מומלץ מאוד. בלי אף מפתח המערכת עובדת על היוריסטיקה,
# שמסננת סביר אבל מפספסת מקרים גבוליים (מי תוקף את מי) ולא מסכמת.
# סדר עדיפות בפועל (ראה relevance._call_ai): Groq ← Gemini ← Claude —
# כל ספק שנכשל מפיל לספק הבא, לא רק כשהמפתח שלו חסר.
#
# Groq — מועדף. חינמי, מכסה יומית נדיבה יותר בפועל מ-Gemini free
# tier. מפתח: console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini — חינמי, גיבוי שני. מפתח: aistudio.google.com/apikey
# (לא דורש כרטיס אשראי, מכסת שימוש יומית שהתבררה לא תמיד אמינה)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Claude — גיבוי אחרון, בתשלום לפי שימוש. מפתח:
# console.anthropic.com → API Keys
ANTHROPIC_API_KEY=
FILTER_MODEL=claude-haiku-4-5-20251001

# ── כוונון ────────────────────────────────────────────────
RSS_INTERVAL_SEC=300        # כל כמה זמן לסרוק פידים
DEDUP_WINDOW_HOURS=6        # חלון לאיחוד דיווחים על אותו אירוע
MAX_ITEMS_PER_FETCH=25      # תקרת פריטים לפיד בסבב
BACKFILL_LIMIT=10           # הודעות אחרונות לערוץ בעלייה
DRY_RUN=false               # true = מדפיס בלבד, לא כותב ל-DB
LOG_LEVEL=INFO
